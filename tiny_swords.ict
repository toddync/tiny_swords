          - type: template
            baseClass: AnimatedSprite
            name: Player
            depth: 0
            texture: qgmTC54FRTL5Mn
            playAnimationOnStart: true
            loopAnimation: true
            animationFPS: 10
            visible: true
            events:
              - eventKey: OnActionDown
                code: |
                  this.vspeed == 0 && (this.looking = "S")

                  if(this.attacking) return
                  value > 0 && (this.scale.x = 1) // Face Rigth
                  value < 0 && (this.scale.x = -1) // Face Left
                  this.hspeed = value * this.speedMod

                  this.tex != "Warrior_W" && (this.tex = "Warrior_W")
                arguments:
                  action: MoveX
                lib: core
              - eventKey: OnActionDown
                code: |-
                  value < 0 && (this.looking = "U") || (this.looking = "D")

                  if(this.attacking) return
                  this.vspeed = value * this.speedMod
                  this.tex = "Warrior_W"
                arguments:
                  action: MoveY
                lib: core
              - eventKey: OnActionRelease
                code: |-
                  if(this.attacking) return
                  this.tex = "Warrior_S"
                arguments:
                  action: MoveX
                lib: core
              - eventKey: OnActionRelease
                code: |-
                  if(this.attacking) return
                  this.tex = "Warrior_S"
                arguments:
                  action: MoveY
                lib: core
              - eventKey: OnCreate
                code: |-
                  camera.follow = this

                  this.attacking = false
                  this.attack = 1

                  this.speedMod = 170
                  this.looking = "S"

                  globalThis.playerPosition = {
                      x: this.x,
                      y: this.y
                  }
                arguments: {}
                lib: core
              - eventKey: OnStep
                code: |-
                  if(this.vspeed != 0 && this.hspeed != 0){
                      this.hspeed =  (1/Math.SQRT2) * this.speedMod * (this.hspeed/this.speedMod)
                      this.vspeed =  (1/Math.SQRT2) * this.speedMod * (this.vspeed/this.speedMod)
                  }
                  this.moveSmart("Solid")
                  this.vspeed == 0 && (this.looking = "S")
                  this.hspeed = 0
                  this.vspeed = 0

                  globalThis.playerPosition = {
                      x: this.x,
                      y: this.y
                  }
                arguments: {}
                lib: core
              - eventKey: OnActionDown
                code: |-
                  if(this.attacking) return

                  this.attacking = true
                  this.tex = `Warrior_${this.looking}${this.attack}`

                  setTimeout(() => {
                      this.attacking = false;
                      this.attack == 1 && (this.attack = 2) || (this.attack = 1)
                      this.tex = "Warrior_S"
                  }, 600)
                arguments:
                  action: Shoot
                lib: core
            extends: {}
            lastmod: 1720403313340
