    uid: nq98TTpMLM9Rnm
    colorClass: success
    icon: help-circle
    name: Scripts
    lastmod: 1720216493713
    entries:
      - uid: 43PjtWr1WhWDm5
        name: makeDungeon
        code: "// Door positions clockwise\nlet U = 0b1000;\nlet R = 0b0100;\nlet B = 0b0010;\nlet L = 0b0001;\nlet Doors = [U, R, B, L];\n\nglobalThis.makeDungeon = (grid, roomCount, { X, Y }) => {\n\tlet doorRemoveCount = Math.ceil(Math.random() * 3);\n\tlet DPos = [...Doors];\n\n\twhile (doorRemoveCount > 0) {\n\t\tshuffle(DPos);\n\t\tDPos.pop();\n\t\tdoorRemoveCount--;\n\t}\n\n\tlet doors = DPos.reduce((a, b) => a + b);\n\n\tlet pos = {\n\t\tx: Math.floor(X / 2),\n\t\ty: Math.floor(Y / 2),\n\t};\n\n\tgrid[pos.y * Y + pos.x] = doors;\n\troomCount--;\n\n\tlet d,\n\t\tP = [pos],\n\t\trc = roomCount,\n\t\t_ = 0,\n\t\tl = 0;\n\twhile (roomCount > 0 && l < X * Y * rc) {\n\t\t[grid, pos, d, _] = tryPlaceRoom(grid, P[0], { X, Y });\n\t\tl++;\n\t\tif (d > 0) {\n\t\t\troomCount -= _;\n\t\t\tP.splice(Math.floor(Math.random() * P.length), 1);\n\t\t\tP.push(pos);\n\t\t\tshuffle(P);\n\t\t}\n\t}\n\tclean(grid, {X,Y})\n\tclean(grid, {X,Y})\n}\n\nfunction clean(grid, {X, Y}) {\n    for (let y = 0; y < Y; y++) {\n        for (let x = 0; x < X; x++) {\n            if (grid[y * Y + x]) {\n                let d = 0;\n                let u = y > 0 ? (y + 1) * Y + x : undefined;     // Top\n                let r = x < X - 1 ? y * Y + (x + 1) : undefined; // Right\n                let b = y < Y ? (y - 1) * Y + x : undefined; // Bottom\n                let l = x > 0 ? y * Y + (x - 1) : undefined;     // Left\n\n                if (u !== undefined && grid[u]) d += U;\n                if (r !== undefined && grid[r]) d += R;\n                if (b !== undefined && grid[b]) d += B;\n                if (l !== undefined && grid[l]) d += L;\n\n                grid[y * Y + x] = d;\n            }\n        }\n    }\n}\n\nfunction tryPlaceRoom(grid, pos, { X, Y }) {\n\tif (Math.random() > 0.5 || pos.y == 0 || pos.y == Y-1) return [grid, pos, 0, 0];\n\tX--;\n\tlet u = (pos.y > 0 && (pos.y - 1) * Y + pos.x) || -1; //Top\n\tlet r = (pos.x < X && pos.y * Y + (pos.x + 1)) || -1; //Right\n\tlet b = (pos.y < Y && (pos.y + 1) * Y + pos.x) || -1; //Bottom\n\tlet l = (pos.x > 0 && pos.y * Y + (pos.x - 1)) || -1; //Left\n\n\tlet _ = Array.of(u, r, b, l).filter((v) => v >= 0);\n\tif (_.length == 0) return [grid, pos, 0, 0];\n\n\tlet RPos = shuffle(_).pop();\n\n\tif (grid[RPos]) return [grid, pos, 0, 0];\n\n\tlet RDoors = [U, R, B, L];\n\n\tif (grid[u] && grid[u] - U > -1) {\n\t\tRDoors.splice(0, 1);\n\t} else if (grid[r] && grid[r] - R > -1) {\n\t\tRDoors.splice(1, 1);\n\t} else if (grid[b] && grid[b] - B > -1) {\n\t\tRDoors.splice(2, 1);\n\t} else if (grid[l] && grid[l] - L > -1) {\n\t\tRDoors.splice(3, 1);\n\t}\n\n\tlet doorRemoveCount = Math.floor(Math.random() * RDoors.length);\n\n\twhile (doorRemoveCount > 0) {\n\t\tshuffle(RDoors);\n\t\tRDoors.pop();\n\t\tdoorRemoveCount--;\n\t}\n\n    //@ts-ignore\n\t_ = RDoors.reduce((a, b) => a + b);\n\tgrid[RPos] = _;\n\n\tswitch (RPos) {\n\t\tcase u:\n\t\t\tpos.y = pos.y - 1;\n\t\t\tbreak;\n\t\tcase r:\n\t\t\tpos.x = pos.x + 1;\n\t\t\tbreak;\n\t\tcase b:\n\t\t\tpos.y = pos.y + 1;\n\t\t\tbreak;\n\t\tcase l:\n\t\t\tpos.x = pos.x - 1;\n\t\t\tbreak;\n\t}\n\n\treturn [grid, pos, _, 1];\n}\n\nfunction shuffle(array) {\n\tlet currentIndex = array.length;\n\twhile (currentIndex != 0) {\n\t\tlet randomIndex = Math.floor(Math.random() * currentIndex);\n\t\tcurrentIndex--;\n\t\t[array[currentIndex], array[randomIndex]] = [\n\t\t\tarray[randomIndex],\n\t\t\tarray[currentIndex],\n\t\t];\n\t}\n\treturn array;\n}"
        language: typescript
        variables: []
        runAutomatically: true
        lastmod: 1720298925713
        type: script
