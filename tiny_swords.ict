      - code: pointer.Primary
      - code: vkeys.Vk1
      - code: gamepad.L2
      - code: gamepad.R2
  - name: Pointer
    methods:
      - code: pointer.DeltaRotation
      - code: pointer.Any
        multiplier: -1
  - name: zoom
    methods:
      - code: pointer.Wheel
