        code: "globalThis.maps = globalThis.maps || {};\n\nglobalThis.maps.Home = {\n    tex: \"HomeTiles\",\n\toffset: {x: 12, y:9},\n\ttileSize: 64,\n\tmapWidth: 23,\n\tmapHeight: 23,\n\tlayers: [\n\t\t{\n\t\t\tname: \"Border_R\",\n\t\t\ttiles: [\n\t\t\t\t{ id: \"0\", x: 17, y: 2 },\n\t\t\t\t{ id: \"0\", x: 19, y: 4 },\n\t\t\t\t{ id: \"0\", x: 18, y: 3 },\n\t\t\t\t{ id: \"0\", x: 20, y: 5 },\n\t\t\t\t{ id: \"0\", x: 20, y: 6 },\n\t\t\t\t{ id: \"0\", x: 20, y: 7 },\n\t\t\t\t{ id: \"0\", x: 20, y: 8 },\n\t\t\t\t{ id: \"0\", x: 20, y: 9 },\n\t\t\t\t{ id: \"0\", x: 20, y: 10 },\n\t\t\t\t{ id: \"0\", x: 19, y: 11 },\n\t\t\t\t{ id: \"0\", x: 18, y: 12 },\n\t\t\t\t{ id: \"0\", x: 18, y: 13 },\n\t\t\t\t{ id: \"0\", x: 17, y: 14 },\n\t\t\t],\n\t\t\tcollider: false,\n\t\t},\n\t\t{\n\t\t\tname: \"Border_L\",\n\t\t\ttiles: [\n\t\t\t\t{ id: \"1\", x: 2, y: 6 },\n\t\t\t\t{ id: \"1\", x: 2, y: 7 },\n\t\t\t\t{ id: \"1\", x: 2, y: 8 },\n\t\t\t\t{ id: \"1\", x: 2, y: 9 },\n\t\t\t\t{ id: \"1\", x: 2, y: 10 },\n\t\t\t\t{ id: \"1\", x: 2, y: 11 },\n\t\t\t\t{ id: \"1\", x: 3, y: 5 },\n\t\t\t\t{ id: \"1\", x: 3, y: 4 },\n\t\t\t\t{ id: \"1\", x: 4, y: 2 },\n\t\t\t\t{ id: \"1\", x: 4, y: 3 },\n\t\t\t\t{ id: \"1\", x: 4, y: 12 },\n\t\t\t\t{ id: \"1\", x: 11, y: 13 },\n\t\t\t\t{ id: \"1\", x: 12, y: 14 },\n\t\t\t],\n\t\t\tcollider: false,\n\t\t},\n\t\t{\n\t\t\tname: \"Border_B\",\n\t\t\ttiles: [\n\t\t\t\t{ id: \"2\", x: 3, y: 11 },\n\t\t\t\t{ id: \"2\", x: 2, y: 11 },\n\t\t\t\t{ id: \"2\", x: 4, y: 12 },\n\t\t\t\t{ id: \"2\", x: 5, y: 12 },\n\t\t\t\t{ id: \"2\", x: 6, y: 12 },\n\t\t\t\t{ id: \"2\", x: 7, y: 12 },\n\t\t\t\t{ id: \"2\", x: 8, y: 12 },\n\t\t\t\t{ id: \"2\", x: 9, y: 12 },\n\t\t\t\t{ id: \"2\", x: 10, y: 12 },\n\t\t\t\t{ id: \"2\", x: 11, y: 13 },\n\t\t\t\t{ id: \"2\", x: 12, y: 14 },\n\t\t\t\t{ id: \"2\", x: 13, y: 14 },\n\t\t\t\t{ id: \"2\", x: 14, y: 14 },\n\t\t\t\t{ id: \"2\", x: 15, y: 14 },\n\t\t\t\t{ id: \"2\", x: 16, y: 14 },\n\t\t\t\t{ id: \"2\", x: 17, y: 14 },\n\t\t\