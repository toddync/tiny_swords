      - type: template
        baseClass: AnimatedSprite
        name: Bridge
        depth: 0
        texture: -1
        playAnimationOnStart: false
        loopAnimation: true
        animationFPS: 30
        visible: true
        events:
          - eventKey: OnCreate
            code: |-
              this.kind = "Bridge"
              this.size = 1 //6
              this.layout = [];
              this.voffset = 32
              this.corner = this.size - 1
              this.offset = -((this.size / 2) * 64)
              this.hoffset = -((this.size / 2) * 64)
              this.x += 32

              let _;

              if(this.orientation == "h"){
                  _ = templates.copy('Tile', this.x + (-1 * 64) + this.hoffset, this.y - this.voffset);
                  _.tex = "Bridge"
                  _.gotoAndStop(0)
                  _.zindex = 10

                  _ = templates.copy('Tile', this.x + ((this.size - 1) * 64) + this.hoffset, this.y - this.voffset);
                  _.tex = "Bridge"
                  _.gotoAndStop(2)
                  _.zindex = 10

                  for(let i = 1; i < this.size; i++){
                      _ = templates.copy('Tile', this.x + ((i - 1) * 64) + this.hoffset, this.y - this.voffset);
                      _.tex = "Bridge"
                      _.gotoAndStop(1)
                      _.zindex = 10

                      _ = templates.copy('Tile', this.x + ((i - 1) * 64) + this.hoffset, this.y - 64 - this.voffset);
                      _.tex = "Grass/Sand"
                      _.cgroup = "Solid"
                      _.gotoAndStop(14)

                      _ = templates.copy('Tile', this.x + ((i - 1) * 64) + this.hoffset, this.y + 54 - this.voffset);
                      _.tex = "Grass/Sand"
                      _.cgroup = "Solid"
                      _.gotoAndStop(14)
                  }
              }else{

              }
            arguments: {}
            lib: core
        extends: {}
        lastmod: 1717985194433
        uid: Lc4qhpR3WpCJRB
        behaviors: []
        extendTypes: ''
