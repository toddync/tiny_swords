      - type: template
        baseClass: AnimatedSprite
        name: builder
        depth: 0
        texture: -1
        playAnimationOnStart: false
        loopAnimation: true
        animationFPS: 30
        visible: true
        events:
          - eventKey: OnCreate
            code: "this.grid = [];\n\nlet grid = [];\nlet sizeX = 101;\nlet sizeY = 101;\n\nlet roomCount = 20;\n\nfor(let y = 0; y < sizeY; y++){\n    for(let x = 0; x < sizeX; x++){\n        grid[y*sizeY+x] = false\n    }\n}\n\n// globalThis.makeDungeon(grid, roomCount, {\n// \tX: sizeX,\n// \tY: sizeY,\n// });\n\n\n// for(let y = 0, Y = -1 * Math.floor(sizeY/2); y < sizeY; y++, Y++){\n//     for(let x = 0, X = -1 * Math.floor(sizeX/2); x < sizeX; x++, X++){\n//         if(grid[y*sizeY+x]){\n//             templates.copy('Room', this.x + X * (3*64), this.y + Y * (3*64), {doors: grid[y*sizeY+x]})\n//         }\n//     }\n// }\n\n\n\nfor (let i = globalThis.maps.Home.layers.length -1; i>=0; i--){\n    layLayer(globalThis.maps.Home.layers[i], globalThis.maps.Home.offset, globalThis.maps.Home.tex, {x: this.x, y:this.y})\n}\n\nfunction layLayer(layer, offset, tex, {x, y}){\n    let _, name = layer.name.toLowerCase()\n    layer.tiles.forEach(tile => {\n        if(name.includes(\"tree\") || name.includes(\"stump\")){ //Trees and Tree stumps\n            _ = templates.copy(\n                'Stump', \n                x + (tile.x*64) - (offset.x*64),\n                y + (tile.y*64) - (offset.y*64),\n                {\n                    zIndex : tile.y,//parseInt(name.split(\":\")[1] || 0),\n                    tree: name.includes(\"tree\")\n                }\n            )\n            return;\n        }\n\n        if(name.includes(\"border\")){ //Borders\n            _ = templates.copy(\n                'Tile', \n                x + (tile.x*64) - (offset.x*64),\n                y + (tile.y*64) - (offset.y*64),\n                {tex: \"border\"}\n            )\n            _.cgroup = \"Solid\"\n            _.alpha = 0\n            name.includes(\"_b\") && ((_.angle = 90) && (_.y -= 5))\n            name.includes(\"_t\") && (_.angle = 270)\n            name.includes(\"_l\") && (_.angle = 180)\n            return;\n        }\n\n        _ = templates.copy('Tile', x + (tile.x*64) - (offset.x*64), y + (tile.y*64) - (offset.y*64))\n        _.tex = tex;\n        _.gotoAndStop(parseInt(tile.id))\n        \n        _.alpha = layer.name.toLowerCase().includes(\"colision\") ? 0 : 1\n        _.cgroup =  layer.name.toLowerCase().includes(\"colision\") ? \"Solid\" : \"\"       \n    })\n}"
            arguments: {}
            lib: core
          - eventKey: OnActionDown
            code: camera.scale.x = camera.scale.y -= value /10
            arguments:
              action: zoom
            lib: core
