backups: 3
language: typescript
notes: |2-
              /* empty */ 
  this.colapse = () => {
      let t = y > 0 && (this.layout[x][y - 1].can.length == 1 && this.layout[x][y - 1].can[0] || false)
      let r = x < this.gridSize -1 && (this.layout[x + 1][y].can.length == 1 && this.layout[x + 1][y].can[0] || false)
      let b = y < this.gridSize -1 && (this.layout[x][y + 1].can.length == 1 && this.layout[x][y + 1].can[0] || false)
      let l = x > 0 && (this.layout[x - 1][y].can.length == 1 && this.layout[x - 1][y].can[0] || false)
      let _ = [t,r,b,l]

      let g = this.layout[y][x].can.indexOf("Bridge")
      _.includes("Bridge") && g > -1 && (this.layout[y][x].can.splice(g, 1))

      g = this.layout[y][x].can.indexOf("Room")
      _.includes("Room") && g > -1 && (this.layout[y][x].can.splice(g, 1))

      if(this.layout[y][x].can._[])
      
      // if(this.layout[y][x].can.includes("Water") && this.layout[y][x].can.includes("Bridge") && !this.layout[y][x].can.includes("Room")){
      //     this.layout[y][x].can = ["Bridge"]
      // } else if(this.layout[y][x].can.includes("Water") && this.layout[y][x].can.includes("Room") && !this.layout[y][x].can.includes("Bridge")){
      //     this.layout[y][x].can = ["Room"]
      // }

      console.log(this.layout[y][x].can, _)


      this.propagate(y,x)
  }

  this.next = () => {
      for(let i = 0; i < this.gridSize; i++){
          for(let j = 0; j < this.gridSize; j++){
              if(this.layout[i][j].can.length == 2){
                  x = j;
                  y = i;
                  return true
              }
          }
      }
      return false
  }

  this.propagate = (i, j) => {            
      i > 0 && !this.layout[i - 1][j].kind && this.up(i-1, j, i, j)
      j > 0 && !this.layout[i][j - 1].kind && this.up(i, j-1, i, j)
      i < (this.gridSize - 1) && !this.layout[i + 1][j].kind && this.up(i+1, j, i, j)
      j < (this.gridSize - 1) && !this.layout[i][j + 1].kind && this.up(i, j+1, i, j)
  }

  this.up = (i, j, ti, tj) => {
      if(this.layout[ti][tj].can.includes("Bridge")){
          let g = this.layout[i][j].can.indexOf("Bridge")
          if(g > -1) this.layout[i][j].can.splice(g, 1)
      }

      if(this.layout[ti][tj].can.includes("Room")){
          let g = this.layout[i][j].can.indexOf("Room")
          if(g > -1) this.layout[i][j].can.splice(g, 1)
      }
  }

  x = Math.floor(Math.random() * (this.gridSize - 1))
  y = Math.floor(Math.random() * (this.gridSize - 1))
  console.log(x,y)
  this.layout[y][x].can = ["Room"]
  this.propagate(y,x)

  let i = 0
  while(this.next() && i < 50){
      this.colapse()
      i++
  }

  // console.log(this.layout)

  for(let i = 0; i < this.gridSize; i++){
      for(let j = 0; j < this.gridSize; j++){
          if(this.layout[i][j].can.length == 1 && this.layout[i][j].can[0] != "Water"){
              if(this.layout[i][j].can[0] == "Room"){
                  this.layout[i][j] = templates.copy('Room', this.x + j * 64, this.y + i * 64)
              }else{
                  this.layout[i][j] = templates.copy("Bridge", this.x + j * 64, this.y + i * 64, {orientation: "h"})
              }
          }
      }
  }
